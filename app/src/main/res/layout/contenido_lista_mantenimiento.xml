<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="14dp"
app:cardCornerRadius="16dp"
android:elevation="0dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:background="@android:color/white">

<!-- ENCABEZADO AZUL -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="@color/colorPrimary"
android:padding="12dp"
android:orientation="horizontal">

<!-- Icono izquierda -->
<ImageView
android:id="@+id/iconoGasolineraEncabezado"
android:layout_width="20dp"
android:layout_height="20dp"
android:src="@drawable/ic_mantenimiento"
android:tint="@color/white"
android:layout_gravity="center_vertical" />

<!-- Espacio flexible -->
<View
android:layout_width="0dp"
android:layout_height="0dp"
android:layout_weight="1" />

<!-- Folio -->
<TextView
android:id="@+id/textView6"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Folio: "
android:textSize="14sp"
android:textColor="@android:color/white"
android:textStyle="bold" />

<TextView
android:id="@+id/TxtFolio"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="1"
android:textSize="14sp"
android:textColor="@android:color/white"
android:textStyle="bold" />
</LinearLayout>

<!-- CONTENIDO -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal">

<!-- Contenido central -->
<LinearLayout
android:layout_width="0dp"
android:layout_height="match_parent"
android:layout_weight="1"
android:orientation="vertical"
android:padding="12dp"
android:gravity="center_vertical">


<!-- Fila 2: Modelo + Producto 2 -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginBottom="4dp">

<!-- Modelo -->
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">

<TextView
android:id="@+id/textEstado"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Estatus:"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/txtEstado"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:textStyle="bold"
android:text="Pendiente"
android:textSize="14sp"
android:textColor="#212121" />

</LinearLayout>
</LinearLayout>

<!-- Fila 1: Marca + Producto 1 -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginBottom="4dp">

<!-- Marca -->
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">

<TextView
android:id="@+id/textDescripcion"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Descripción:"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/TxtDescripcion"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="PEMEX PREMIUM"
android:textStyle="bold"
android:textSize="14sp"
android:textColor="#212121" />
</LinearLayout>
</LinearLayout>

<!-- Producto 2 -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginBottom="4dp">
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">
<TextView
android:id="@+id/txt3"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Fecha y hora de registro:"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/TxtFechaHora"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="01 de febrero de 2024, 1:00 am a 2:04 am"
android:textSize="14sp"
android:textColor="#212121" />
</LinearLayout>
</LinearLayout>

</LinearLayout>

<!-- Ícono derecho -->
<LinearLayout
android:layout_width="35dp"
android:layout_height="match_parent"
android:gravity="center"
android:orientation="horizontal">

<ImageView
android:id="@+id/iconoDetalleExtintor"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:src="@drawable/ic_arrow_right" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
</androidx.cardview.widget.CardView>
