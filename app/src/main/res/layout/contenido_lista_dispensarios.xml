<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="14dp"
app:cardCornerRadius="16dp"
android:elevation="0dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:background="@android:color/white">

<!-- ENCABEZADO AZUL -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="@color/colorPrimary"
android:padding="12dp"
android:orientation="horizontal">

<!-- Icono izquierda -->
<ImageView
android:id="@+id/iconoGasolineraEncabezado"
android:layout_width="20dp"
android:layout_height="20dp"
android:src="@drawable/ic_dispensarios"
android:tint="@color/white"
android:layout_gravity="center_vertical" />

<!-- Espacio flexible -->
<View
android:layout_width="0dp"
android:layout_height="0dp"
android:layout_weight="1" />

<!-- Folio -->
<TextView
android:id="@+id/textView6"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="No. Dispensario: "
android:textSize="14sp"
android:textColor="@android:color/white"
android:textStyle="bold" />

<TextView
android:id="@+id/NoDispensario"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="1"
android:textSize="14sp"
android:textColor="@android:color/white"
android:textStyle="bold" />
</LinearLayout>

<!-- CONTENIDO -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal">

<!-- Contenido central -->
<LinearLayout
android:layout_width="0dp"
android:layout_height="match_parent"
android:layout_weight="1"
android:orientation="vertical"
android:padding="12dp"
android:gravity="center_vertical">

<!-- Fila 1: Producto y Litros de compra -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginBottom="4dp">

<!-- Marca -->
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Marca:"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/Marca"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Wayne"
android:textSize="14sp"
android:textColor="#212121" />
</LinearLayout>
<!-- Producto 1 -->
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">
<TextView
android:id="@+id/NomProducto1"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:textStyle="bold"
android:text="Producto 1:"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/Producto1"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Premium"
android:textSize="14sp"
android:textColor="#212121" />
</LinearLayout>
</LinearLayout>
<!-- Fila 2: Modelo + Producto 2 -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginBottom="4dp">

<!-- Modelo -->
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Modelo:"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/Modelo"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="MXP-2000"
android:textSize="14sp"
android:textColor="#212121" />
</LinearLayout>

<!-- Producto 2 -->
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">
<TextView
android:id="@+id/NomProducto2"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:textStyle="bold"
android:text="Producto 2:"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/Producto2"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Magna"
android:textSize="14sp"
android:textColor="#212121" />
</LinearLayout>
</LinearLayout>

<!-- Fila 3: Serie + Producto 3 -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal">

<!-- Serie -->
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Serie:"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/Serie"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="ABC123XYZ"
android:textSize="14sp"
android:textColor="#212121" />
</LinearLayout>

<!-- Producto 3 -->
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical"
android:visibility="gone">
<TextView
android:id="@+id/NomProducto3"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:textStyle="bold"
android:text="Producto 3:"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/Producto3"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Diesel"
android:textSize="14sp"
android:textColor="#212121" />
</LinearLayout>
</LinearLayout>

</LinearLayout>
    
</LinearLayout>
</LinearLayout>
</androidx.cardview.widget.CardView>
