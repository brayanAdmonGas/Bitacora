<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@android:color/transparent">

<androidx.cardview.widget.CardView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:clipToOutline="true"
android:layout_gravity="center">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:background="@android:color/white">

<!-- Encabezado del mensaje -->
<TextView
android:id="@+id/alertHeader"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="@color/colorSecondary"
android:text="¡Mensaje de alerta!"
android:padding="18dp"
android:textStyle="bold"
android:textColor="@color/white"
android:gravity="center"
android:textSize="20sp"/>

<!-- Cuerpo -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:padding="20dp">

<ImageView
android:id="@+id/imageView4"
android:layout_width="150dp"
android:layout_height="150dp"
android:layout_gravity="center"
android:layout_marginTop="16dp"
android:src="@drawable/icon_alert_warning"
android:contentDescription="Alerta" />

<TextView
android:id="@+id/txtMensaje"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="16dp"
android:text="Este es un mensaje de advertencia."
android:textSize="16sp"
android:textColor="#616161"
android:gravity="center" />

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginTop="24dp"
android:gravity="center">

<com.google.android.material.button.MaterialButton
android:id="@+id/alertCancelar"
style="@style/Widget.MaterialComponents.Button.OutlinedButton"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:text="Cancelar"
android:textColor="#FF6961"
app:strokeColor="#FF6961"
android:layout_marginEnd="8dp"
app:strokeWidth="1.5dp"
app:cornerRadius="16dp"
android:layout_marginStart="8dp"/>

<com.google.android.material.button.MaterialButton
android:id="@+id/alertAceptar"
style="@style/Widget.MaterialComponents.Button.OutlinedButton"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:text="Aceptar"
android:textColor="@color/colorSecondary"
app:strokeColor="@color/colorSecondary"
android:layout_marginEnd="8dp"
app:strokeWidth="1.5dp"
app:cornerRadius="16dp" />

</LinearLayout>

</LinearLayout>
</LinearLayout>
</androidx.cardview.widget.CardView>
</FrameLayout>
