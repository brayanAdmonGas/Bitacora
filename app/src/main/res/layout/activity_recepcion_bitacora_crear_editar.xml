<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#F5F5F5"
android:fitsSystemWindows="true"
tools:context=".recepcion.RecepcionBitacoraCrearEditar">

<!-- AppBar -->
<com.google.android.material.appbar.AppBarLayout
android:id="@+id/appBarLayout"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:background="?attr/colorPrimary"
android:elevation="0dp"
app:layout_constraintTop_toTopOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent">

<androidx.appcompat.widget.Toolbar
android:id="@+id/toolbar"
android:layout_width="match_parent"
android:layout_height="?attr/actionBarSize"
app:title="Agregar recepción y descarga"
app:titleTextColor="@android:color/white"
app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
app:titleTextAppearance="@style/TextAppearance.Widget.AppCompat.Toolbar.Title"
app:navigationIcon="@drawable/ic_arrow_left_white" />
</com.google.android.material.appbar.AppBarLayout>

<!-- Contenido desplazable -->
<ScrollView
android:id="@+id/root_scroll"
android:layout_width="0dp"
android:layout_height="0dp"
android:fillViewport="true"
app:layout_constraintTop_toBottomOf="@id/appBarLayout"
app:layout_constraintBottom_toBottomOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:padding="16dp">

<!-- Card 1 -->
<com.google.android.material.card.MaterialCardView
android:layout_width="match_parent"
android:layout_height="wrap_content"
app:cardCornerRadius="16dp"
app:cardElevation="0dp"
android:backgroundTint="#FFFFFF">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:padding="16dp">

<include layout="@layout/mensaje_fuera_rango" />

<!-- FECHA DE RECEPCION -->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Fecha de recepción"
app:startIconDrawable="@drawable/ic_calendar"
app:startIconTint="#79747e"
android:textColorHint="#A6A6A6">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/FechaRecepcion"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:clickable="true"
android:focusable="false"
android:hint="Fecha"
android:inputType="none"
android:padding="15dp"
android:textSize="15sp" />
</com.google.android.material.textfield.TextInputLayout>

<!-- HORA DE LLEGADA -->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:hint="Hora de llegada"
app:startIconDrawable="@drawable/ic_hora_sistema"
app:startIconTint="#79747e"
android:textColorHint="#A6A6A6">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/HoraLlegada"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:focusable="false"
android:inputType="none"
android:textSize="15sp"
android:padding="15dp" />
</com.google.android.material.textfield.TextInputLayout>

<!-- HORA DE SALIDA -->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:hint="Hora de salida"
app:startIconDrawable="@drawable/ic_hora_sistema"
app:startIconTint="#79747e"
android:textColorHint="#A6A6A6">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/HoraSalida"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:textSize="15sp"
android:padding="15dp"
android:focusable="false"
android:inputType="none"/>
</com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<!-- Card 2 -->
<androidx.cardview.widget.CardView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="12dp"
app:cardCornerRadius="16dp"
android:layout_marginTop="16dp"
android:elevation="0dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:background="@android:color/white">

<!-- ENCABEZADO AZUL -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="@color/colorSecondary"
android:padding="12dp"
android:gravity="center">

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Datos del transporte"
android:textColor="@android:color/white"
android:textSize="14sp"
android:textStyle="bold"/>
</LinearLayout>

<!-- CONTENIDO -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:padding="16dp">

<!-- Linea de transporte -->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Línea de transporte"
app:startIconDrawable="@drawable/ic_recepcion_descarga"
app:startIconTint="#79747e"
android:textColorHint="#A6A6A6">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/LineaTransporte"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="text"
android:textSize="15sp"
android:padding="15dp" />
</com.google.android.material.textfield.TextInputLayout>

<!-- No. de remolque-->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:hint="No. de remolque"
app:startIconDrawable="@drawable/ic_numero"
app:startIconTint="#79747e"
android:textColorHint="#A6A6A6">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/NoRemolque"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="text"
android:textSize="15sp"
android:padding="15dp" />
</com.google.android.material.textfield.TextInputLayout>

<!-- Placas del vehiculo-->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:hint="Placa del vehiculo"
app:startIconDrawable="@drawable/ic_cars_movil"
app:startIconTint="#79747e"
android:textColorHint="#A6A6A6">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/Placas"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="text"
android:textSize="15sp"
android:padding="15dp" />
</com.google.android.material.textfield.TextInputLayout>

<!-- Nombre del operador -->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:hint="Nombre completo del operador"
app:startIconDrawable="@drawable/ic_user"
app:startIconTint="#79747e"
android:textColorHint="#A6A6A6">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/Operador"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="text"
android:textSize="15sp"
android:padding="15dp" />
</com.google.android.material.textfield.TextInputLayout>

<!-- Manometro -->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:hint="Manometro"
app:startIconDrawable="@drawable/ic_manometro"
app:startIconTint="#79747e"
android:textColorHint="#A6A6A6">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/Manometro"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="number"
android:textSize="15sp"
android:padding="15dp" />
</com.google.android.material.textfield.TextInputLayout>

<!-- Temperatura -->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:hint="Temperatura"
app:startIconDrawable="@drawable/ic_temperatura"
app:startIconTint="#79747e"
android:textColorHint="#A6A6A6">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/Temperatura"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="number"
android:textSize="15sp"
android:padding="15dp" />
</com.google.android.material.textfield.TextInputLayout>

<!-- No. de DRUM -->
<com.google.android.material.textfield.TextInputLayout
android:id="@+id/InputLayout"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:hint="No. de DRUM"
app:startIconDrawable="@drawable/ic_numero"
app:startIconTint="#79747e"
android:textColorHint="#A6A6A6"
android:visibility="gone">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/NoDrum"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="text"
android:textSize="15sp"
android:padding="15dp" />
</com.google.android.material.textfield.TextInputLayout>

<!-- No. de factura -->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:hint="No. de factura"
app:startIconDrawable="@drawable/ic_bitacora"
app:startIconTint="#79747e"
android:textColorHint="#A6A6A6">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/NoFactura"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="text"
android:textSize="15sp"
android:padding="15dp" />
</com.google.android.material.textfield.TextInputLayout>

<!-- Litros de compra -->
<com.google.android.material.textfield.TextInputLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:layout_marginBottom="6dp"
android:hint="Litros de compra"
app:startIconDrawable="@drawable/ic_money_gas"
app:startIconTint="#79747e"
android:textColorHint="#A6A6A6">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/LitrosCompra"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="number"
android:textSize="15sp"
android:padding="15dp" />
</com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
</LinearLayout>

</LinearLayout>
</androidx.cardview.widget.CardView>

<!-- Card 2 -->
<androidx.cardview.widget.CardView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="16dp"
app:cardCornerRadius="16dp"
android:elevation="0dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:background="@android:color/white">

<!-- ENCABEZADO AZUL -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="@color/colorSecondary"
android:padding="12dp"
android:gravity="center">

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Datos del tanque"
android:textColor="@android:color/white"
android:textSize="14sp"
android:textStyle="bold"/>
</LinearLayout>

<!-- CONTENIDO -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:padding="16dp">

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Selecciona el producto de la recepción:"
android:textColor="#757575"
android:textSize="14sp" />

<!-- PRODUCTO 87 OCT -->
<com.google.android.material.card.MaterialCardView
android:layout_width="match_parent"
android:layout_height="wrap_content"
app:cardCornerRadius="12dp"
app:strokeColor="#79747e"
app:strokeWidth="1dp"
app:cardElevation="0dp"
android:layout_marginTop="10dp"
app:cardBackgroundColor="#FFFFFF">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="center_vertical"
android:orientation="horizontal"
android:padding="12dp">

<ImageView
android:layout_width="24dp"
android:layout_height="24dp"
android:layout_marginEnd="12dp"
android:src="@drawable/ic_tanque"
android:tint="#79747e" />

<TextView
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:fontFamily="sans-serif"
android:text="PRODUCTO 87 OCT"
android:textColor="#424242"
android:textSize="15sp" />

<androidx.appcompat.widget.SwitchCompat
android:id="@+id/Producto1"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:checked="false" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<!-- PRODUCTO 91 OCT -->
<com.google.android.material.card.MaterialCardView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="8dp"
app:cardCornerRadius="12dp"
app:strokeColor="#79747e"
app:strokeWidth="1dp"
app:cardElevation="0dp"
app:cardBackgroundColor="#FFFFFF">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="center_vertical"
android:orientation="horizontal"
android:padding="12dp">

<ImageView
android:layout_width="24dp"
android:layout_height="24dp"
android:layout_marginEnd="12dp"
android:src="@drawable/ic_tanque"
android:tint="#79747e" />

<TextView
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:fontFamily="sans-serif"
android:text="PRODUCTO 91 OCT"
android:textColor="#424242"
android:textSize="15sp" />

<androidx.appcompat.widget.SwitchCompat
android:id="@+id/Producto2"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:checked="false" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<!-- PRODUCTO D -->
<com.google.android.material.card.MaterialCardView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="8dp"
app:cardCornerRadius="12dp"
app:strokeColor="#79747e"
app:strokeWidth="1dp"
app:cardElevation="0dp"
app:cardBackgroundColor="#FFFFFF">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="center_vertical"
android:orientation="horizontal"
android:padding="12dp">

<ImageView
android:layout_width="24dp"
android:layout_height="24dp"
android:layout_marginEnd="12dp"
android:src="@drawable/ic_tanque"
android:tint="#79747e" />

<TextView
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:fontFamily="sans-serif"
android:text="PRODUCTO D"
android:textColor="#424242"
android:textSize="15sp" />

<androidx.appcompat.widget.SwitchCompat
android:id="@+id/Producto3"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:checked="false" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>


<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Selecciona el numero de tanque, inventario inicial e inventario final:"
android:textColor="#757575"
android:layout_marginTop="22dp"
android:layout_marginBottom="12dp"
android:textSize="14sp" />

<!-- TANQUE 1 -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:layout_marginBottom="16dp">

<com.google.android.material.card.MaterialCardView
android:layout_width="match_parent"
android:layout_height="wrap_content"
app:cardCornerRadius="12dp"
app:strokeColor="#79747e"
app:strokeWidth="1dp"
app:cardBackgroundColor="#FFFFFF"
app:cardPreventCornerOverlap="false"
app:cardUseCompatPadding="false"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent"
android:layout_marginBottom="8dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:gravity="center_vertical"
android:padding="4dp">

<!-- Icono a la izquierda -->
<ImageView
android:layout_width="24dp"
android:layout_height="24dp"
android:layout_marginEnd="12dp"
android:layout_marginStart="10dp"

android:src="@drawable/ic_tanque"
android:tint="#79747e" />

<!-- Spinner estilizado -->
<Spinner
android:id="@+id/spinnerTanque1"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:background="@android:color/transparent"
android:paddingVertical="4dp"
android:textAlignment="viewStart"
android:textDirection="ltr"
android:textSize="15sp"
android:spinnerMode="dropdown" />

</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<!-- Horizontal layout -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:weightSum="2"
android:gravity="center">

<com.google.android.material.textfield.TextInputLayout
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:layout_marginEnd="8dp"
android:hint="Inventario Inicial"
style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
app:startIconDrawable="@drawable/ic_dispensarios"
app:startIconTint="#79747e">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/InventarioI1"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="numberDecimal"
android:textSize="15sp"
android:padding="12dp" />
</com.google.android.material.textfield.TextInputLayout>

<com.google.android.material.textfield.TextInputLayout
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:layout_marginStart="8dp"
android:hint="Inventario Final"
style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
app:startIconDrawable="@drawable/ic_dispensarios"
app:startIconTint="#79747e">

<com.google.android.material.textfield.TextInputEditText
android:id="@+id/InventarioF1"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="numberDecimal"
android:textSize="15sp"
android:padding="12dp" />
</com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
</LinearLayout>

