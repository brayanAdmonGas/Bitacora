<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="14dp"
app:cardCornerRadius="16dp"
android:elevation="0dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:background="@android:color/white">

<!-- ENCABEZADO AZUL -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="@color/colorPrimary"
android:padding="12dp"
android:orientation="horizontal">

<!-- Icono izquierda -->
<ImageView
android:id="@+id/iconoGasolineraEncabezado"
android:layout_width="20dp"
android:layout_height="20dp"
android:src="@drawable/ic_detector_humo"
android:tint="@color/white"
android:layout_gravity="center_vertical" />

<!-- Espacio flexible -->
<View
android:layout_width="0dp"
android:layout_height="0dp"
android:layout_weight="1" />

<!-- Folio -->
<TextView
android:id="@+id/textView6"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="No. Detector de Humo: "
android:textSize="14sp"
android:textColor="@android:color/white"
android:textStyle="bold" />

<TextView
android:id="@+id/NoDetectorHumo"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="1"
android:textSize="14sp"
android:textColor="@android:color/white"
android:textStyle="bold" />
</LinearLayout>

<!-- CONTENIDO -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal">

<!-- Contenido central -->
<LinearLayout
android:layout_width="0dp"
android:layout_height="match_parent"
android:layout_weight="1"
android:orientation="vertical"
android:padding="12dp"
android:gravity="center_vertical">

<!-- Fila 2: Modelo + Producto 2 -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginBottom="4dp">

<!-- Modelo -->
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">

<TextView
android:id="@+id/txt2"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Ubicación:"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/Ubicacion"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:textSize="14sp"
android:textColor="#212121" />

</LinearLayout>
</LinearLayout>

<!-- Producto 2 -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginBottom="4dp">
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">
<TextView
android:id="@+id/TxtRevision1"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Revisión auditiva (Emisión de sonido):"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/TxtResultado1"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:textSize="14sp"
android:textStyle="bold"
android:textColor="#212121" />
</LinearLayout>
</LinearLayout>

<!-- Producto 2 -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginBottom="4dp">
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">
<TextView
android:id="@+id/TxtRevision2"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Revisión visual (Emisión de luz indicadora):"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/TxtResultado2"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:textSize="14sp"
android:textStyle="bold"
android:textColor="#212121" />
</LinearLayout>
</LinearLayout>

<!-- Producto 2 -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginBottom="4dp">
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">
<TextView
android:id="@+id/TxtRevision3"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="¿La medición del detector es el óptimo?:"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/TxtResultado3"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:textSize="14sp"
android:textStyle="bold"
android:textColor="#212121" />
</LinearLayout>
</LinearLayout>

<!-- Producto 2 -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:layout_marginBottom="4dp">
<LinearLayout
android:layout_width="0dp"
android:layout_weight="1"
android:layout_height="wrap_content"
android:orientation="vertical">
<TextView
android:id="@+id/TxtRevision4"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="¿Requiere cambio de batería?:"
android:textSize="12sp"
android:textColor="#757575" />
<TextView
android:id="@+id/TxtResultado4"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:textSize="14sp"
android:textStyle="bold"
android:textColor="#212121" />
</LinearLayout>
</LinearLayout>


</LinearLayout>
</LinearLayout>
</LinearLayout>
</androidx.cardview.widget.CardView>
